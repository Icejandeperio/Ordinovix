{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npm uninstall *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx vite *)",
      "Bash(npx eslint *)",
      "Bash(npx playwright *)",
      "Bash(node scripts/verify.mjs *)",
      "Bash(node scripts/verify.mjs)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git pull --ff-only)",
      "Bash(git push -u origin *)",
      "Bash(git push origin u*)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git restore --staged *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr merge * --squash *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh auth status *)",
      "Bash(npx wrangler dev)",
      "Bash(npx wrangler dev *)",
      "Bash(npx wrangler types)",
      "Bash(npx wrangler types *)",
      "Bash(npx wrangler check *)",
      "Bash(npx wrangler --version)",
      "Bash(npx wrangler d1 migrations *)",
      "Bash(npx wrangler d1 execute *)",
      "Bash(npx drizzle-kit generate)",
      "Bash(npx drizzle-kit generate *)",
      "Bash(npx drizzle-kit check)",
      "Bash(npx drizzle-kit check *)",
      "Bash(npm run dev:vars)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/scripts/verify.mjs)",
      "Edit(/scripts/verify.ps1)",
      "Edit(/eslint.config.js)",
      "Edit(/playwright.config.ts)",
      "Edit(/docs/product/**)",
      "Edit(/docs/adr/**)",
      "Edit(/Inspirations/**)",
      "Edit(/docs/state/QA_AUDIT_2026-10-27.md)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin master *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge * --admin *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(npm publish *)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler deploy *)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler login)",
      "Bash(npx wrangler login *)",
      "Bash(npx wrangler * --remote *)",
      "Bash(npx wrangler * --remote)",
      "Bash(npx wrangler d1 create *)",
      "Bash(npx wrangler d1 delete *)",
      "Bash(npx wrangler r2 bucket *)",
      "Bash(npx wrangler versions *)",
      "Bash(npx wrangler rollback *)",
      "Bash(npx wrangler delete *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(npx drizzle-kit push)",
      "Bash(npx drizzle-kit migrate *)",
      "Bash(npx drizzle-kit migrate)"
    ]
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
