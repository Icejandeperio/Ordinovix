{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["./**/*.ts", "../worker-configuration.d.ts", "../src/domain/**/*.ts", "../src/lib/dates.ts"],
  "exclude": ["../src/domain/**/*.test.ts"]
}
