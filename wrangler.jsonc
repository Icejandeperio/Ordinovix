// Ordinovix Worker configuration. Names, bindings and environments are fixed by docs/adr/ADR-0002 (section 3):
// the top level is local development, env.preview and env.production are what CI deploys.
// The all-zero database ids are placeholders; the owner's setup script (scripts/setup-cloudflare.mjs) writes the real ones.
// Secrets are never listed here: BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, VAPID_PUBLIC_KEY,
// VAPID_PRIVATE_KEY, FILE_URL_SIGNING_KEY, TIN_ENCRYPTION_KEY (local values in .dev.vars, written by `npm run dev:vars`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordinovix-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The same Worker serves the built app. Only /api/* runs the Worker code first; every other path is a static file
  // or falls back to index.html for the client-side router.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cron triggers, UTC: 0 19 = 03:00 Manila clean-up (worker/cron/retention.ts); 0 23 = 07:00 digest and reminders and 0 9 = 17:00
  // visit check (worker/cron/notify.ts).
  "triggers": { "crons": ["0 19 * * *", "0 23 * * *", "0 9 * * *"] },
  "vars": { "APP_ENV": "local" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ordinovix-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ordinovix-local-files" }],
  "env": {
    "preview": {
      "name": "ordinovix-preview",
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "triggers": { "crons": ["0 19 * * *", "0 23 * * *", "0 9 * * *"] },
      "vars": { "APP_ENV": "preview" },
      "d1_databases": [
        { "binding": "DB", "database_name": "ordinovix-preview", "database_id": "cc5ec0a6-c682-4c1e-9df3-a63176183387", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ordinovix-preview-files" }]
    },
    "production": {
      "name": "ordinovix",
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "triggers": { "crons": ["0 19 * * *", "0 23 * * *", "0 9 * * *"] },
      "vars": { "APP_ENV": "production" },
      "d1_databases": [
        { "binding": "DB", "database_name": "ordinovix", "database_id": "032ca71e-2078-4a27-bea9-a3c48c550e8f", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ordinovix-files" }]
    }
  }
}
